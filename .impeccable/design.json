    {
      "name": "Account toggle",
      "kind": "button",
      "html": "<button class=\"ds-toggle\" type=\"button\" aria-expanded=\"false\"><span>Read the full account</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" aria-hidden=\"true\"><path d=\"M3 5.25 7 9.25l4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-toggle{display:inline-flex;align-items:center;gap:.5rem;min-height:40px;padding:0;border:0;background:none;color:var(--rubric,#8e2a17);font-family:var(--font-display,'Cinzel Variable',serif);font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:color 140ms ease}.ds-toggle:hover{color:var(--rubric-deep,#6c1a0b)}.ds-toggle:focus-visible{outline:2px solid var(--rubric,#8e2a17);outline-offset:6px}.ds-toggle svg{transition:transform 260ms cubic-bezier(.16,1,.3,1)}.ds-toggle[aria-expanded=true] svg{transform:rotate(180deg)}"
    },
    {
      "name": "Ledger entry",
      "kind": "custom",
      "html": "<div class=\"ds-entry\" data-reached=\"true\"><p class=\"ds-year\">509 BC</p><span class=\"ds-dot\"></span><div class=\"ds-body\"><h3 class=\"ds-title\">Roman Republic Established</h3><p class=\"ds-summary\">The monarchy is overthrown after Tarquinius Superbus's son rapes Lucretia, leading to the creation of the Roman Republic.</p></div></div>",
      "css": ".ds-entry{display:grid;grid-template-columns:7.5rem 2.5rem minmax(0,1fr);column-gap:1.25rem;align-items:start;background:var(--paper,#f1e4c8);padding:1rem}.ds-year{margin:0;padding-top:.2rem;color:var(--rubric,#8e2a17);font-family:var(--font-display,'Cinzel Variable',serif);font-size:1rem;font-weight:700;letter-spacing:.06em;text-align:right;font-variant-numeric:tabular-nums}.ds-dot{position:relative;display:block;width:15px;height:15px;margin:.45rem auto 0;border:2px solid var(--rubric,#8e2a17);border-radius:50%;background:var(--paper,#f1e4c8)}.ds-dot::after{content:'';position:absolute;inset:2px;border-radius:50%;background:var(--gold-bright,#e6bf6a);transform:scale(0);transition:transform 380ms cubic-bezier(.16,1,.3,1)}.ds-entry[data-reached=true] .ds-dot::after{transform:scale(1);box-shadow:0 0 0 4px rgba(230,191,106,.25)}.ds-title{margin:0;color:var(--ink,#1d100b);font-family:var(--font-display,'Cinzel Variable',serif);font-size:1.6rem;font-weight:700;line-height:1.3;letter-spacing:.03em}.ds-summary{margin:.6rem 0 0;max-width:66ch;color:var(--ink-soft,#3d261b);font-family:var(--font-body,'EB Garamond Variable',serif);font-size:1.15rem;line-height:1.6}"
    },
    {
      "name": "Era ruler segment",
      "kind": "nav",
      "html": "<nav class=\"ds-ruler\" aria-label=\"Eras of Rome\"><a class=\"ds-seg\" href=\"#\" style=\"flex-grow:244\"><span class=\"ds-seg-name\">The Kingdom</span><span class=\"ds-seg-year\">753 BC</span></a><a class=\"ds-seg ds-seg-current\" href=\"#\" style=\"flex-grow:482\"><span class=\"ds-seg-name\">The Republic</span><span class=\"ds-seg-year\">509 BC</span></a><a class=\"ds-seg\" href=\"#\" style=\"flex-grow:503\"><span class=\"ds-seg-name\">The Empire</span><span class=\"ds-seg-year\">27 BC</span></a></nav>",
      "css": ".ds-ruler{position:relative;display:flex;padding:.55rem 1rem 0;background:var(--field,#160c08);border-top:1px solid rgba(230,191,106,.28)}.ds-seg{position:relative;display:flex;flex-basis:0;flex-direction:column;gap:.15rem;min-height:44px;padding:.35rem .5rem 0 0;color:rgba(243,231,207,.5);text-decoration:none;transition:color 260ms ease}.ds-seg::before{content:'';position:absolute;top:-.55rem;left:0;width:1px;height:.55rem;background:rgba(230,191,106,.55)}.ds-seg:hover{color:#f3e7cf}.ds-seg-current{color:var(--gold-bright,#e6bf6a)}.ds-seg:focus-visible{outline:2px solid var(--gold-bright,#e6bf6a);outline-offset:2px}.ds-seg-name{font-family:var(--font-display,'Cinzel Variable',serif);font-size:.74rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ds-seg-year{font-family:var(--font-body,'EB Garamond Variable',serif);font-size:.86rem;font-variant-numeric:tabular-nums}"
